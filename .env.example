# ==============================================================================
# AI-WAF Environment Configuration Template
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
LOG_LEVEL=INFO

# WAF Gateway Server Settings
WAF_HOST=0.0.0.0
WAF_PORT=8000

# Target Protected Application URL (Upstream reverse proxy destination)
UPSTREAM_URL=http://protected-demo-app:3000

# Database Configuration (PostgreSQL with AsyncPG)
POSTGRES_USER=waf_user
POSTGRES_PASSWORD=waf_secure_password_change_me
POSTGRES_DB=ai_waf
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://waf_user:waf_secure_password_change_me@postgres:5432/ai_waf

# Redis Configuration (Rate Limiting & Transient State)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Security Policy & Risk Thresholds
# Scores range 0 - 100:
#   0 <= score <= ALLOW_THRESHOLD  -> ALLOW
#   ALLOW_THRESHOLD < score < BLOCK_THRESHOLD -> FLAG
#   BLOCK_THRESHOLD <= score <= 100 -> BLOCK
ALLOW_THRESHOLD=29
FLAG_THRESHOLD=69
BLOCK_THRESHOLD=70

# Detection Operating Mode:
#   BLOCK     - Real-time blocking of attacks exceeding BLOCK_THRESHOLD
#   FLAG_ONLY - Logs and flags threats but permits requests upstream
#   MONITOR   - Passive monitoring mode for baseline assessment
DETECTION_MODE=BLOCK

# Rate Limiting Parameters
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST_ALLOWANCE=20

# Request Safeguards & Limits (in bytes and seconds)
MAX_REQUEST_BODY_SIZE=10485760 # 10 MB
MAX_HEADER_SIZE=16384          # 16 KB
REQUEST_TIMEOUT_SECONDS=10.0

# Machine Learning Model Configuration
ML_MODEL_PATH=ml/models/waf_classifier_v1.joblib
ML_VECTORIZER_PATH=ml/models/tfidf_vectorizer_v1.joblib
ML_METADATA_PATH=ml/models/metadata_v1.json
ML_ENABLED=true

# Admin UI / Dashboard
FRONTEND_PORT=5173
NGINX_PORT=80
